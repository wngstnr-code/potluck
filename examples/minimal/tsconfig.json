{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client"],
    // @polkadot/* typings are not compatible with exactOptionalPropertyTypes.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "vite.config.ts"]
}
