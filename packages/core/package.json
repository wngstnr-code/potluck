{
  "name": "@potluck/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared indexing engine: source adapters, decoding, spec engine, canonical encoding, chunking.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:live": "POTLUCK_LIVE=1 vitest run"
  },
  "dependencies": {
    "@polkadot/rpc-provider": "17.0.2",
    "@polkadot/types": "17.0.2",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "@potluck/spec": "workspace:*",
    "viem": "2.57.7"
  }
}
