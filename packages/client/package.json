{
  "name": "@potluck/client",
  "version": "0.0.0",
  "private": true,
  "description": "Browser SDK: adaptive sync, snapshot loading, verification, local SQL and live tail.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:live": "POTLUCK_LIVE=1 vitest run"
  },
  "dependencies": {
    "@polkadot/util-crypto": "14.0.3",
    "@potluck/core": "workspace:*",
    "@potluck/spec": "workspace:*",
    "viem": "2.57.7"
  }
}
