# Portaldot V3 testnet (data layer: TransactionStorage + PotluckRegistry on pallet-revive)
PORTALDOT_WS=wss://test-node-v3.portaldot.dev
PORTALDOT_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CHAIN_ID=420420777

# Source chains (public archive nodes)
POLKADOT_AH_WS=wss://polkadot-asset-hub-rpc.polkadot.io
KUSAMA_AH_WS=wss://kusama-asset-hub-rpc.polkadot.io

# Deployed registry addresses (filled after deployment)
REGISTRY_ADDRESS_PVM=
REGISTRY_ADDRESS_EVM=

# Dev-only publisher account seed. Put the real value in .env (git-ignored). Never commit it.
PUBLISHER_SEED=
