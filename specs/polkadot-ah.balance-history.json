{
  "potluck": 1,
  "name": "polkadot-ah.balance-history",
  "description": "Every change to an account's total (free + reserved) DOT balance on Polkadot Asset Hub since smart contracts went live, as debit/credit rows that reconcile exactly against System.Account.",
  "source": {
    "kind": "substrate-events",
    "chain": "polkadot-asset-hub",
    "genesisHash": "0x68d56f15f85d3136970ec16946040bc1752654e906147f7e43e9d539d7c3de2f",
    "fromBlock": 11405259
  },
  "columns": ["kind", "from", "to", "amount"],
  "accounts": ["from", "to"],
  "match": [
    {
      "pallet": "Balances",
      "event": "Transfer",
      "row": {
        "kind": "Transfer",
        "from": "$from",
        "to": "$to",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "ReserveRepatriated",
      "row": {
        "kind": "ReserveRepatriated",
        "from": "$from",
        "to": "$to",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "TransferOnHold",
      "row": {
        "kind": "TransferOnHold",
        "from": "$source",
        "to": "$dest",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "TransferAndHold",
      "row": {
        "kind": "TransferAndHold",
        "from": "$source",
        "to": "$dest",
        "amount": "$transferred"
      }
    },
    {
      "pallet": "Balances",
      "event": "Deposit",
      "row": {
        "kind": "Deposit",
        "to": "$who",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "Minted",
      "row": {
        "kind": "Minted",
        "to": "$who",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "Restored",
      "row": {
        "kind": "Restored",
        "to": "$who",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "Withdraw",
      "row": {
        "kind": "Withdraw",
        "from": "$who",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "Slashed",
      "row": {
        "kind": "Slashed",
        "from": "$who",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "Burned",
      "row": {
        "kind": "Burned",
        "from": "$who",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "BurnedHeld",
      "row": {
        "kind": "BurnedHeld",
        "from": "$who",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "Suspended",
      "row": {
        "kind": "Suspended",
        "from": "$who",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "DustLost",
      "row": {
        "kind": "DustLost",
        "from": "$account",
        "amount": "$amount"
      }
    },
    {
      "pallet": "Balances",
      "event": "BalanceSet",
      "row": {
        "kind": "BalanceSet",
        "to": "$who",
        "amount": "$free"
      },
      "effect": "opaque"
    },
    {
      "pallet": "System",
      "event": "KilledAccount",
      "row": {
        "kind": "KilledAccount",
        "to": "$account",
        "amount": "0"
      },
      "effect": "reset"
    }
  ],
  "reconcile": {
    "type": "balance-delta",
    "storage": {
      "pallet": "System",
      "item": "Account"
    },
    "sum": ["data.free", "data.reserved"],
    "debit": "from",
    "credit": "to",
    "amount": "amount"
  },
  "chunk": {
    "maxBlocks": 50000,
    "maxRawBytes": 32000000
  }
}
